# Public URL of the live website (used for canonical URLs, sitemap & Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.goodwillskillsacademy.in

# MongoDB connection string — local: mongodb://127.0.0.1:27017 · cloud: MongoDB Atlas "Connect → Drivers" URI
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=goodwill_skills_academy

# Admin panel login
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=replace-with-a-long-random-string
